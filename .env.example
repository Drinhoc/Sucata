# ============================================
# Configurações do Sistema de Controle de Sucata
# ============================================

# Nome da aplicação (exibido no cabeçalho)
APP_NAME=Sistema de Controle de Sucata

# Senha de acesso ao sistema (OBRIGATÓRIO)
# Defina uma senha forte para proteger o acesso
APP_PASSWORD=suasenhaaqui

# URL de conexão com o banco de dados PostgreSQL (OBRIGATÓRIO)
# No Railway: gerado automaticamente ao adicionar o plugin PostgreSQL
# Localmente: postgresql://usuario:senha@localhost:5432/sucata
DATABASE_URL=postgresql://usuario:senha@localhost:5432/sucata
